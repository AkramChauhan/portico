{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portico",
  "version": "0.1.0",
  "identifier": "io.portico.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Portico",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local vhosts with trusted HTTPS, plus public tunnels.",
    "externalBin": [
      "binaries/portico-hostsd"
    ]
  }
}
